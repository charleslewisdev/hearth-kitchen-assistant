DATABASE_URL=postgres://hearth:hearth@localhost:5432/hearth

# The URL a browser uses to reach Hearth. One value: it is the auth base URL, the CORS
# allow-list, the trusted origin, and - via its scheme - whether session cookies are marked
# Secure. Scheme and host (and port, if not the default) only: no path, query, or fragment.
# Set this to your https:// address before exposing the instance, or every login sets a cookie
# over plaintext. Left unset it falls back to WEB_ORIGIN, which is what keeps `pnpm dev` (the
# vite server on :5173) working; `docker compose up` publishes on http://localhost:8080.
# PUBLIC_URL=https://hearth.example.com

# Signs session cookies. LEAVE IT UNSET and one is generated on first boot into DATA_DIR;
# that is the recommended setup, since a generated secret is never in a file you might commit.
# The value below is published in this repository: anyone can forge a session cookie for any
# account with it, so the server REFUSES to start on it when NODE_ENV=production.
#
# Note that `docker compose` also reads YOUR .env for interpolation, so a dev value here is
# passed into the container, where NODE_ENV=production, and the stack refuses to start with a
# message naming this variable. Comment it out (or set it empty) to have one generated instead.
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-long

# Where the generated auth secret is kept. Must be on a volume that survives a container
# rebuild - losing it re-signs every session, i.e. logs the whole household out.
DATA_DIR=./.data

# ---------------------------------------------------------------------------
# CLAIMING A FRESH INSTANCE (first boot)
# ---------------------------------------------------------------------------
# Hearth is invite-only: the household owner invites people by email and there is no open
# registration. That leaves one question - who creates the FIRST account, when there is nobody
# to invite them? A first-boot setup token, generated into DATA_DIR and printed on every boot
# until the household exists:
#
#   hearth-server  | WARN: This Hearth has no household yet. Create the first account by
#                  | sending the header "x-hearth-setup-token: <token>" ...
#
# Read it from that line (`docker compose logs server`) or from DATA_DIR/setup-token, and send
# it as the `x-hearth-setup-token` header on the sign-up request. Anyone who can read your logs
# or that file can claim the instance, so do not publish the port before you have. Both stop
# mattering the moment the household exists: the file is deleted and the line stops printing.
#
# Without the token an uninvited sign-up is refused - which is the point. If any stranger could
# create the first account, one request would be enough to make the instance permanently
# unusable: sign-up would then be closed to everyone, with no owner to issue invitations.

# Whether this instance hosts exactly one household. Leave it alone.
# `true` (the default) is what every part of the app assumes today: invitees join the owner's
# existing household and share its recipe library, which is why tenant scoping needed no
# changes. `false` only removes the enforcement - it does not add household switching or the
# rest of a real multi-tenant surface - and it must be paired with dropping the
# `organization_singleton_uidx` index, which is what actually holds the line.
SINGLE_HOUSEHOLD=true

# Who may say which client a request came from, via X-Forwarded-For. It decides the client IP
# that logs and rate limits use (D46):
#   0            = nobody. Directly exposed, or not yet configured. This is the default.
#   1            = one proxy, whoever it is (the Vite dev proxy counts as one).
#   192.168.1.1  = only this proxy, e.g. HAProxy on your firewall. Comma-separate several, or use
#                  a CIDR. Prefer this when the published port is reachable by other machines.
# Too little trust throttles every user as one; too much lets a client pick its own bucket.
TRUST_PROXY=0

PORT=3000
# development | test | production. Set this to production when deploying; development is
# what turns on human-readable pretty logs.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent. Logs carry ids, never recipe or
# message content, so debug is safe to leave on for a while when chasing something. With no SMTP
# configured this setting also gates invitation delivery: see the email section below.
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Email. Hearth sends exactly two kinds of message: a household invitation and an address
# verification. Both are a single link, and both are needed to add anyone to your household,
# because accounts are invite-only.
#
# LEAVE SMTP_HOST UNSET and Hearth does not send mail at all. It WRITES THE INVITATION LINK
# INTO ITS OWN LOG instead, so that an instance with no mail relay can still onboard your
# family. Read that consequence literally:
#
#     ANYONE WHO CAN READ THESE LOGS CAN ACCEPT THE INVITATION AND JOIN YOUR HOUSEHOLD,
#     which means reading every recipe, meal plan and shopping list in it.
#
# On a box only you can log into that is fine, and it is the intended zero-config setup. It is
# NOT fine if you forward logs anywhere else: a hosted log collector, a Discord webhook, a
# pastebin in a support thread. Configure SMTP before you do any of those. Hearth says which
# mode it is in on one line at startup: `warn` for console mode, and `info` for SMTP - the level
# follows which of the two you need to be told about. The console line and the link lines are
# therefore both at `warn`, and the mail logger keeps its own floor there, so lowering LOG_LEVEL
# to `error` or `fatal` hides neither and cannot break invitations. LOG_LEVEL=silent is the one
# exception, and it does mean silent: no links, so console mode cannot onboard anyone at that
# setting. Configure SMTP if you want both silence and invitations.
#
# SMTP_HOST=smtp.example.com
# 587 is the submission port and pairs with SMTP_SECURE=false (STARTTLS). Use 465 with
# SMTP_SECURE=true for implicit TLS.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hearth@example.com
# SMTP_PASS=
# The envelope From. Defaults to hearth@localhost, which most relays REJECT because the domain
# has no MX record, so set this to an address on a domain your relay is authorised to send for.
# Home IP addresses deliver poorly whatever you put here; a relay you already own (your mail
# provider, or a transactional service) is the reliable option.
# SMTP_FROM=hearth@example.com

# The old spelling of PUBLIC_URL, and the last of the pair that used to configure the public
# identity. Set PUBLIC_URL on a deployment and leave this alone; it survives only as PUBLIC_URL's
# fallback, which is what keeps `pnpm dev` working on the vite server below without a second
# variable, and what the fixtures in e2e/ read for the same address.
#
# `BETTER_AUTH_URL` used to sit here and is gone: nothing has read it since the public identity
# became one value, and it is no longer in the schema, so setting it now is ignored rather than
# validated. If you have it in a .env from an older checkout, delete the line.
#
# Set neither this nor PUBLIC_URL and the server refuses to start, with a message naming
# PUBLIC_URL, which is the one to set.
WEB_ORIGIN=http://localhost:5173
